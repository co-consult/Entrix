/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model access_control_log {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  access_right_id   String         @db.Uuid
  access_point_id   String?        @db.VarChar(255)
  user_id           String         @db.Uuid
  event_id          String         @db.Uuid
  action            access_action
  result            access_status
  denial_reason     denial_reason?
  controller_device String?        @db.VarChar(100)
  ip_address        String?        @db.Inet
  scan_metadata     Json?
  notes             String?
  scanned_at        DateTime       @default(now()) @db.Timestamptz(6)
  created_at        DateTime       @default(now()) @db.Timestamptz(6)
  access_points     access_points? @relation(fields: [access_point_id], references: [id], onUpdate: NoAction, map: "fk_access_control_log_access_point")
  access_rights     access_rights  @relation(fields: [access_right_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_access_control_log_access_right")
  events            events         @relation(fields: [event_id], references: [id], onUpdate: NoAction, map: "fk_access_control_log_event")
  users             users          @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_access_control_log_user")

  @@index([access_point_id], map: "idx_access_control_log_access_point")
  @@index([access_right_id], map: "idx_access_control_log_access_right")
  @@index([action], map: "idx_access_control_log_action")
  @@index([denial_reason], map: "idx_access_control_log_denial_reason")
  @@index([event_id], map: "idx_access_control_log_event")
  @@index([event_id, scanned_at, denial_reason, result], map: "idx_access_control_log_event_denied")
  @@index([event_id, scanned_at, result], map: "idx_access_control_log_event_success")
  @@index([result], map: "idx_access_control_log_result")
  @@index([scanned_at], map: "idx_access_control_log_scanned_at")
  @@index([user_id], map: "idx_access_control_log_user")
  @@index([user_id, scanned_at], map: "idx_access_control_log_user_recent")
  @@index([scanned_at, result], map: "idx_access_control_venue_monthly")
}

