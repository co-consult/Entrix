###############################################################################

### 9.1 Test limite rate limiting registration
# Test: Dépassement limite inscriptions par IP
# Attendu: 429 Too Many Requests après 3 tentatives/heure
POST {{baseUrl}}/{{apiVersion}}/auth/register
Content-Type: {{contentType}}

{
  "email": "test1@example.com",
  "password": "{{testPassword}}",
  "firstName": "Test",
  "lastName": "User1",
  "termsAccepted": true
}

###
POST {{baseUrl}}/{{apiVersion}}/auth/register
Content-Type: {{contentType}}

{
  "email": "test2@example.com",
  "password": "{{testPassword}}",
  "firstName": "Test",
  "lastName": "User2",
  "termsAccepted": true
}

###
POST {{baseUrl}}/{{apiVersion}}/auth/register
Content-Type: {{contentType}}

{
  "email": "test3@example.com",
  "password": "{{testPassword}}",
  "firstName": "Test",
  "lastName": "User3",
  "termsAccepted": true
}

###
POST {{baseUrl}}/{{apiVersion}}/auth/register
Content-Type: {{contentType}}

{
  "email": "test4@example.com",
  "password": "{{testPassword}}",
  "firstName": "Test",
  "lastName": "User4",
  "termsAccepted": true
}

### 9.2 Test payload large (Edge case)
# Test: Gestion requêtes volumineuses
# Attendu: 400 Bad Request ou traitement normal
POST {{baseUrl}}/{{apiVersion}}/auth/register
Content-Type: {{contentType}}

{
  "email": "large.payload@entrix.tn",
  "password": "{{testPassword}}",
  "firstName": "A".repeat(1000),
  "lastName": "B".repeat(1000),
  "termsAccepted": true
}

###############################################################################
# 10. TESTS DE SÉCURITÉ
###############################################################################

### 10.1 Injection SQL (Test sécurité)
# Test: Tentative injection dans email
# Attendu: 400 Bad Request ou traitement sécurisé
POST {{baseUrl}}/{{apiVersion}}/auth/login
Content-Type: {{contentType}}

{
  "email": "'; DROP TABLE users; --",
  "password": "{{testPassword}}"
}

### 10.2 XSS dans les champs (Test sécurité)
# Test: Script malveillant dans les données
# Attendu: 400 Bad Request ou échappement
POST {{baseUrl}}/{{apiVersion}}/auth/register
Content-Type: {{contentType}}

{
  "email": "xss@test.com",
  "password": "{{testPassword}}",
  "firstName": "<script>alert('xss')</script>",
  "lastName": "Test",
  "termsAccepted": true
}

### 10.3 Headers malveillants (Test sécurité)
# Test: Headers d'attaque
# Attendu: Traitement sécurisé ou rejet
POST {{baseUrl}}/{{apiVersion}}/auth/login
Content-Type: {{contentType}}
X-Forwarded-For: 127.0.0.1
X-Real-IP: 192.168.1.1
User-Agent: <script>malicious</script>

{
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

###############################################################################
# NOTES D'UTILISATION:
# 
# 1. Variables automatiques:
#    - Les réponses remplissent automatiquement les variables @accessToken, etc.
#    - Utiliser ces variables dans les tests suivants
#
# 2. Ordre des tests:
#    - Inscription → Connexion → Tests protégés → Déconnexion
#    - Respecter l'ordre pour la cohérence des données
#
# 3. Configuration serveur:
#    - Modifier @baseUrl selon votre environnement
#    - Adapter @apiVersion selon votre configuration
#
# 4. Rate limiting:
#    - Attendre entre les tests si rate limiting activé
#    - Ou utiliser différentes adresses IP/emails
#
# 5. Données de test:
#    - Modifier @testEmail pour éviter les conflits
#    - Utiliser emails temporaires pour tests répétés
#
# 6. Réponses attendues:
#    - Vérifier codes de statut HTTP
#    - Examiner structure des réponses JSON
#    - Contrôler présence des champs requis
#
# 7. Environnements:
#    - DEV: http://localhost:3000
#    - STAGING: https://api-staging.entrix.tn
#    - PROD: https://api.entrix.tn
###############################################################################