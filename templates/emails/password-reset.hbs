{{!-- src/modules/auth/templates/password-reset.hbs --}}
{{!-- Template email reset mot de passe Entrix V3.0 --}}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Réinitialisation de mot de passe - Entrix</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; padding: 0; background-color: #f5f5f5; }
        .container { max-width: 600px; margin: 0 auto; background-color: #ffffff; }
        .header { background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%); color: white; padding: 40px 30px; text-align: center; }
        .content { padding: 40px 30px; }
        .button { display: inline-block; background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%); color: white; padding: 15px 30px; text-decoration: none; border-radius: 5px; font-weight: bold; }
        .warning { background-color: #fff3cd; border: 1px solid #ffeaa7; padding: 15px; border-radius: 5px; margin: 20px 0; }
        .footer { background-color: #f8f9fa; padding: 20px 30px; text-align: center; color: #6c757d; font-size: 14px; }
        .security-code { font-family: 'Courier New', monospace; font-size: 18px; background-color: #f8f9fa; padding: 10px; border-radius: 5px; text-align: center; letter-spacing: 2px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🔑 Réinitialisation de mot de passe</h1>
            <p>Sécurisez votre compte Entrix</p>
        </div>
        
        <div class="content">
            <h2>Bonjour {{firstName}} !</h2>
            
            <p>Vous avez demandé la réinitialisation de votre mot de passe Entrix. Pour des raisons de sécurité, utilisez le lien ci-dessous :</p>
            
            <div style="text-align: center; margin: 30px 0;">
                <a href="{{resetLink}}" class="button">Réinitialiser mon mot de passe</a>
            </div>
            
            <div class="warning">
                <strong>⚠️ Important</strong>
                <ul style="margin: 10px 0;">
                    <li>Ce lien expire dans <strong>{{expiryDuration}}</strong></li>
                    <li>Il ne peut être utilisé qu'une seule fois</li>
                    <li>Si vous n'avez pas fait cette demande, ignorez cet email</li>
                </ul>
            </div>
            
            <h3>📱 Autre option : Code de vérification</h3>
            <p>Vous pouvez aussi utiliser ce code sur la page de réinitialisation :</p>
            
            <div class="security-code">
                {{verificationCode}}
            </div>
            
            <h3>🛡️ Conseils sécurité</h3>
            <p>Pour un mot de passe sécurisé :</p>
            <ul>
                <li>Minimum 8 caractères</li>
                <li>Mélange de majuscules, minuscules, chiffres et symboles</li>
                <li>Évitez les informations personnelles</li>
                <li>Utilisez un gestionnaire de mots de passe</li>
            </ul>
            
            <h3>📊 Détails de la demande</h3>
            <ul style="font-size: 14px; color: #6c757d;">
                <li><strong>Date :</strong> {{requestDate}}</li>
                <li><strong>IP :</strong> {{ipAddress}}</li>
                <li><strong>Localisation :</strong> {{location}}</li>
                <li><strong>Appareil :</strong> {{deviceInfo}}</li>
            </ul>
        </div>
        
        <div class="footer">
            <p>Entrix - Sécurité et confiance</p>
            <p>Si cette demande ne vient pas de vous, <a href="{{supportUrl}}">contactez-nous immédiatement</a>.</p>
            <p style="font-size: 12px;">
                Email automatique - Ne pas répondre | <a href="{{platformUrl}}">entrix.tn</a>
            </p>
        </div>
    </div>
</body>
</html>